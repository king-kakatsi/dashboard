# Auth Service environment template.
# Copy to .env and fill in real values. Never commit .env.
# The service refuses to start if a required variable is missing.

# Required: MongoDB connection string (Prisma + Mongoose use this)
DATABASE_URL="mongodb://localhost:27017/dashboard_auth"

# Required: secret used to sign JWT access tokens (min 32 random chars)
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional: token lifetime (default 7d). Cookie lifetime is 24h.
JWT_EXPIRES_IN="7d"

# Required: SMTP settings for verification emails
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="you@example.com"
MAIL_PASS="your-app-password"
# Optional: sender address (defaults to MAIL_USER)
MAIL_FROM="you@example.com"

# Required for OAuth token encryption (any long random string)
ENCRYPTION_KEY="change-me-to-a-long-random-key"

# Optional: Google OAuth (required only if Google login is enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Optional: GitHub OAuth (required only if GitHub login is enabled)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3001/auth/github/callback"

# Optional: Cloudinary (required only for profile image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL of the connectors microservice (default http://localhost:3000)
CONNECTORS_SERVICE_URL="http://localhost:3000"

# Public frontend URL used in email links and OAuth redirects
FRONTEND_URL="http://localhost:5173"

# Optional: service port (default 3001) and environment
PORT="3001"
NODE_ENV="development"
