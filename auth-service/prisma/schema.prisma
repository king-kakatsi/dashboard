generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
  MICROSOFT
}

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  email         String        @unique
  standByEmail  String?
  username      String
  standByUsername String?
  image         String?
  password      String?       // Optional for OAuth users
  standByPassword      String?      
  role          UserRole      @default(USER)

  // Connected services (IDs from connectors-service)
  // Store as array of strings since they're external IDs
  connectedServiceIds String[]  @default([]) 
  connectors Json?
  
  // Active widgets (IDs from connectors-service)
  // Each widget belongs to a service
  activeWidgetIds     String[]  @default([])
  widgets Json?
  
  // OAuth fields
  provider      AuthProvider  @default(LOCAL)
  providerId    String?       // OAuth provider user ID
  accessToken   String?       // Encrypted OAuth access token
  refreshToken  String?       // Encrypted OAuth refresh token
  
  verified      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // @@unique([provider, providerId])
  @@map("users")
}