# Connectors Service environment template.
# Copy to .env and fill in real values. Never commit .env.
# The service refuses to start if DATABASE_URL is missing.

# Required: MongoDB connection string (database name "dashboard" is appended by config)
DATABASE_URL="mongodb://localhost:27017/dashboard"

# URL of the auth microservice (used for Google OAuth token checks)
AUTH_SERVICE_URL="http://localhost:3001"

# Public frontend URL used in OAuth redirects
FRONTEND_URL="http://localhost:5173"

# Optional: Google OAuth (required only for Gmail/proxy features)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/proxy/callback"

# Unused legacy key, kept for compatibility
GOOGLE_API_KEY=""

# Optional: service port (default 3000) and environment
PORT="3000"
NODE_ENV="development"
